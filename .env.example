NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# The Polyvise API runs every debate and follow-up. Defaults to
# https://api.polyvise.ai, which needs a key. For local work, run polyvise-api
# (`uv run uvicorn polyvise_api.main:app`) and point at it; it needs no key and
# answers from deterministic templates.
POLYVISE_API_URL="http://localhost:8000"
# POLYVISE_API_KEY=""

# Where the API can reach this app, so each model answer is checked and
# repaired here (evidence, reading level, complete sentences). The host must be
# listed in the API's POLYVISE_API_CALLBACK_HOSTS. Leave unset to skip the
# checks; the audience rules still go out with every prompt.
# DEBATEFROG_CALLBACK_URL="http://localhost:3001"

# Debatefrog's model for each round. Everything else about the engine
# (timeouts, token limits, evidence provider, provider keys) is set on the API.
POLYVISE_QUICK_MODEL="google/gemini-2.5-flash"
POLYVISE_DEEP_MODEL="openai/gpt-4.1"
POLYVISE_OPENING_MODEL="openai/gpt-4o-mini"
POLYVISE_CROSS_EXAMINATION_MODEL="openai/gpt-4o-mini"
POLYVISE_REBUTTAL_MODEL="openai/gpt-4.1"
POLYVISE_CLOSING_MODEL="openai/gpt-4.1"
POLYVISE_JUDGE_MODEL="openai/gpt-4.1"
